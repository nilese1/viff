# Copy to .env and edit. Compose loads this automatically.

# development | test | production
APP_ENV=development

# Bound to 0.0.0.0:8000 inside the container
APP_HOST=0.0.0.0
APP_PORT=8000

# Only used when APP_ENV=production. Compose's prod profile sets this for you.
DATABASE_URL=postgresql+asyncpg://viff:viff@db:5432/viff

# Path used when APP_ENV != production. Relative to the working directory.
SQLITE_PATH=./data/dev.db

# Change in production
SECRET_KEY=dev-secret-change-me

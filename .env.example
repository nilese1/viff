# Copy to .env and edit. Compose loads this automatically.

# development | test | production
APP_ENV=development

# Bound to 0.0.0.0:8000 inside the container
APP_HOST=0.0.0.0
APP_PORT=8000

# Only used when APP_ENV=production. Compose's prod profile sets this for you.
DATABASE_URL=postgresql+asyncpg://viff:viff@db:5432/viff

# Path used when APP_ENV != production. Relative to the working directory.
SQLITE_PATH=./data/dev.db

# Change in production
SECRET_KEY=dev-secret-change-me

# local | gcs. Use gcs with GCS's S3-compatible XML API via boto3.
ARCHIVE_STORAGE_BACKEND=local
ARCHIVE_STORAGE_PATH=./data/archive
ARCHIVE_BUCKET=
ARCHIVE_PREFIX=viff
ARCHIVE_GCS_ENDPOINT_URL=https://storage.googleapis.com
# boto3 reads these for GCS HMAC credentials when ARCHIVE_STORAGE_BACKEND=gcs.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
